# 3.7 Mô hình AI (XGBoost + LSTM)
# ---------------------------------------------------------------
anchor = find_para(doc, 'SHAP Expanability', style='List Paragraph')
insert_para(anchor, 'Đề tài triển khai và so sánh hai mô hình cho bài toán dự báo delay_days theo hướng hồi quy '
            '(regression): XGBoost đóng vai trò baseline trên dữ liệu dạng bảng, và LSTM đóng vai trò mô hình '
            'chính khai thác yếu tố chuỗi thời gian.')
insert_para(anchor, [('XGBoost Regressor: ', True)], bullet=False)
xgb_items = [
    'Tham số: n_estimators = 500, max_depth = 6, learning_rate = 0.05, subsample = 0.8, colsample_bytree = 0.8, '
    'objective = reg:squarederror.',
    'Huấn luyện trực tiếp trên 262 đặc trưng (sau one-hot), có early-stopping thông qua eval_set trên tập validation.',
]
for s in xgb_items:
    insert_para(anchor, s, bullet=True, numId=10)
insert_para(anchor, [('LSTM: ', True)], bullet=False)
lstm_items = [
    'Kiến trúc: 1 tầng LSTM (64 units) → Dropout (0.2) → Dense (32, ReLU) → Dense (1).',
    'Đầu vào là chuỗi 30 bước quan sát gần nhất (sequence length = 30), mỗi bước gồm 31 đặc trưng số đã '
    'chuẩn hoá bằng StandardScaler (fit trên tập train).',
    'Huấn luyện với optimizer Adam, loss MSE, batch_size = 256, tối đa 20 epoch, kèm EarlyStopping '
    '(patience = 4, khôi phục trọng số tốt nhất trên validation).',
]
for s in lstm_items:
    insert_para(anchor, s, bullet=True, numId=10)
insert_para(anchor, 'Việc lựa chọn XGBoost làm baseline dựa trên khả năng xử lý tốt dữ liệu dạng bảng với chi '
            'phí huấn luyện thấp, trong khi LSTM được kỳ vọng khai thác thêm thông tin từ diễn biến giao hàng '
            'theo thời gian — kết quả so sánh thực nghiệm được trình bày chi tiết ở Chương 4.')

# ---------------------------------------------------------------
# 3.8 SHAP / Explainability
# ---------------------------------------------------------------
anchor = find_para(doc, 'Inventory Optimization', style='List Paragraph')
insert_para(anchor, 'Khả năng giải thích là một yêu cầu quan trọng khi triển khai mô hình dự báo rủi ro vào '
            'thực tế, vì người quản lý chuỗi cung ứng cần biết lý do một đơn hàng được đánh giá là có nguy cơ '
            'trễ cao trước khi ra quyết định. SHAP (SHapley Additive exPlanations) là phương pháp được đề tài '
            'lựa chọn về mặt phương pháp luận, dựa trên lý thuyết trò chơi hợp tác để phân bổ đóng góp của từng '
            'đặc trưng vào một dự báo cụ thể, phù hợp với các mô hình cây như XGBoost thông qua TreeExplainer.')
insert_para(anchor, 'Trong phạm vi bản demo của đồ án, mức độ ảnh hưởng của đặc trưng được xấp xỉ bằng '
            'feature importance dạng Gain có sẵn của XGBoost (đóng góp trung bình của mỗi đặc trưng vào việc '
            'giảm sai số trên toàn bộ các cây quyết định), hiển thị trực tiếp trên giao diện dự báo dưới dạng '
            'biểu đồ tỉ trọng. Đây là một xấp xỉ ở cấp độ toàn cục (global importance); việc tích hợp SHAP đầy '
            'đủ để giải thích ở cấp độ từng dự báo (local explanation) được đề xuất là hướng phát triển tiếp '
            'theo, khi đồ án có thêm thời gian để tối ưu chi phí tính toán của TreeExplainer trên tập dữ liệu '
            'quy mô lớn.')

