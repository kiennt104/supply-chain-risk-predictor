# 3.9 Inventory Optimization
# ---------------------------------------------------------------
anchor = find_para(doc, 'Quy trình hoạt động của Framework đề xuất', style='List Paragraph')
insert_para(anchor, 'Từ số ngày trễ dự báo (delay_days), đề tài đề xuất một quy tắc đơn giản (rule-based) để '
            'gợi ý mức tồn kho an toàn bổ sung, thay vì chỉ dừng lại ở việc đưa ra một con số dự báo:')
insert_para(anchor, 'buffer_days = max(0, delay_days) × 1.5 + 1', bullet=True, numId=10)
insert_para(anchor, 'Hệ số 1.5 phản ánh mức độ thận trọng (an toàn) mong muốn trước sai số dự báo, còn phần '
            'cộng thêm 1 ngày là mức đệm tối thiểu áp dụng cho mọi đơn hàng. Đơn hàng được phân theo ba mức rủi '
            'ro dựa trên delay_days dự báo — Thấp (< 0,5 ngày), Trung bình (0,5–1,5 ngày) và Cao (> 1,5 ngày) — '
            'để hỗ trợ trực quan hoá và ưu tiên xử lý trên giao diện demo. Đây là một quy tắc mang tính minh '
            'hoạ khả năng ứng dụng của dự báo vào quyết định vận hành; việc xây dựng một mô hình tối ưu hoá '
            'tồn kho đầy đủ (ví dụ theo mô hình (s, S) hoặc Newsvendor có điều kiện theo rủi ro) được đề xuất '
            'là hướng phát triển tiếp theo.')

